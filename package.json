{
  "name": "brasil-afora-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "//drizzle-beta-tracking": "drizzle-orm/drizzle-kit pinned to 1.0.0-beta.9: no stable 1.x release exists yet (latest stable 0.45.3 predates the casing API in use), so downgrading would break the app. Monitor https://github.com/drizzle-team/drizzle-orm/releases and upgrade to 1.x stable when it lands, then run bun install, bun run db:generate, and the full test suite.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run && node --test src/data/showcase-opportunities.test.mjs",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "auth:generate": "bunx --bun @better-auth/cli generate --output ./src/db/schema/auth.ts",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:studio": "bunx --bun drizzle-kit studio",
    "data:audit": "bun run src/scripts/audit-and-backfill-opportunities.ts",
    "cost:missing": "bun run src/scripts/cost-profiles-missing.ts",
    "semantic:audit": "tsx src/scripts/audit-semantic-field-states.ts",
    "semantic:backfill": "tsx src/scripts/audit-semantic-field-states.ts --apply",
    "local:bootstrap-reviewer": "bun run src/scripts/bootstrap-local-reviewer.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@next/third-parties": "^16.2.11",
    "@react-email/components": "^0.5.7",
    "@tanstack/react-query": "^5.90.3",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-beta.9-e89174b",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "next": "16.2.11",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "react-leaflet": "^5.0.0",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-beta.9-e89174b",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "ultracite": "7.5.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.10",
    "sharp": "^0.35.0",
    "uuid": "^11.1.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
