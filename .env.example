# Copy to `.env` (local) or configure the same keys in your hosting provider.
# Never commit real secrets.

# --- Required in all environments -------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brasil_afora
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
RESEND_API_KEY=re_example
RESEND_FROM_EMAIL=Brasil Afora <noreply@example.org>
# Required at startup (Google login is unconditionally enabled in src/lib/auth.ts;
# keep non-empty placeholder values locally if you are not testing Google OAuth).
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# --- Optional database & URL overrides --------------------------------------
# Runtime DB client prefers DATABASE_PRIVATE_URL over DATABASE_URL when set
# (Drizzle CLI and scripts still read DATABASE_URL directly).
# DATABASE_PRIVATE_URL=
# PEM-encoded CA certificate for PostgreSQL SSL (use \n for newlines):
# DATABASE_SSL_CA=
# Fallback client auth URL when NEXT_PUBLIC_APP_URL is unset:
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# --- CORS --------------------------------------------------------------------
# Comma-separated allowlist of browser origins trusted by Better Auth.
# REQUIRED in production (the app throws at startup when missing).
# Local development defaults to http://localhost:3000 when unset.
CORS_ORIGIN=http://localhost:3000

# --- Feature flags -----------------------------------------------------------
# Set to "true" to enable structured opportunity reads (default: false).
# NEXT_PUBLIC_STRUCTURED_OPPORTUNITIES=false

# --- Ingestion / maintenance service tokens (optional, min. 32 chars if set) -
# When unset, routes fall back to admin session auth. If set with < 32 chars,
# the affected endpoints return 503.
INGESTION_API_TOKEN=
MAINTENANCE_WORKER_TOKEN=
OUTBOX_WORKER_TOKEN=

# --- Rate limiting ------------------------------------------------------------
# In-memory fixed-window limiting is the default (single instance / dev).
# For production with multiple instances, configure a distributed store:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV equivalents are also accepted: KV_REST_API_URL / KV_REST_API_TOKEN)

# Optional overrides (defaults: auth 10/min, ingestion 30/min, default 100/min)
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_INGESTION_MAX=30
# RATE_LIMIT_INGESTION_WINDOW_MS=60000
# RATE_LIMIT_DEFAULT_MAX=100
# RATE_LIMIT_DEFAULT_WINDOW_MS=60000

# --- Local scripts & cross-language tests (optional) ------------------------
# Used by `bun run local:bootstrap-reviewer` (email must end in .local, min 12-char password):
# LOCAL_REVIEWER_EMAIL=reviewer@brasil-afora.local
# LOCAL_REVIEWER_PASSWORD=change-me-12-chars
# Used by cross-language Vitest suites (bf07 / bf10) in `bun run test`:
# BRASIL_AFORA_PYTHON_REPO=
# BRASIL_AFORA_PYTHON=
