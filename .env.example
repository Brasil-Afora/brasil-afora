# Copy to `.env` (local) or configure the same keys in your hosting provider.
# Never commit real secrets.

# --- Required in all environments -------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brasil_afora
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
RESEND_API_KEY=re_example
RESEND_FROM_EMAIL=Brasil Afora <noreply@example.org>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CORS --------------------------------------------------------------------
# Comma-separated allowlist of browser origins trusted by Better Auth.
# REQUIRED in production (the app throws at startup when missing).
# Local development defaults to http://localhost:3000 when unset.
CORS_ORIGIN=http://localhost:3000

# --- Ingestion / maintenance service tokens (min. 32 chars) -------------------
INGESTION_API_TOKEN=
MAINTENANCE_WORKER_TOKEN=
OUTBOX_WORKER_TOKEN=

# --- Rate limiting ------------------------------------------------------------
# In-memory fixed-window limiting is the default (single instance / dev).
# For production with multiple instances, configure a distributed store:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV equivalents are also accepted: KV_REST_API_URL / KV_REST_API_TOKEN)

# Optional overrides (defaults: auth 10/min, ingestion 30/min, default 100/min)
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_INGESTION_MAX=30
# RATE_LIMIT_INGESTION_WINDOW_MS=60000
# RATE_LIMIT_DEFAULT_MAX=100
# RATE_LIMIT_DEFAULT_WINDOW_MS=60000
